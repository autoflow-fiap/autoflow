%% Registro histórico da Fase 2; não representa os gates atuais do workflow.
flowchart TB

    subgraph cicd["CI/CD - GitHub Actions"]
        repository["Repositório Git"] --> triggers["push ou pull_request<br/>develop / main"]
        triggers --> backendTests["Testes do backend + Sonar"]
        triggers --> frontendTests["Testes do frontend"]
        backendTests --> backendBuild["Build do backend"]
        frontendTests --> frontendBuild["Build do frontend"]
        backendBuild --> publish["Publicação de imagens<br/>Docker Hub"]
        frontendBuild --> publish
        triggers -. "push em develop" .-> snyk["Snyk<br/>verificação paralela"]
        publish --> deploy["deploy-aws"]
        deploy --> terraform["Terraform<br/>provisiona AWS e aplica manifestos K8s"]
    end

    subgraph aws["AWS - us-east-1"]
        subgraph vpc["VPC - sub-redes públicas e privadas, rotas, NAT e grupos de segurança"]
            subgraph eks["EKS + node group"]
                subgraph k8s["Recursos Kubernetes"]
                    frontendService["Frontend<br/>Service LoadBalancer"]
                    frontendDeployment["Frontend<br/>Deployment"]
                    frontendConfig["ConfigMap<br/>frontend"]
                    backendService["Backend<br/>Service LoadBalancer"]
                    backendDeployment["Backend<br/>Deployment"]
                    backendConfig["ConfigMap<br/>backend"]
                    backendSecret["Secret<br/>backend"]
                    hpa["HPA backend<br/>mín. 1 / máx. 3<br/>CPU 50%"]
                end
            end
        end
        rds["RDS PostgreSQL<br/>sub-redes privadas<br/>acesso público habilitado"]
        stateBucket["S3 state-autoflow-terraform<br/>criado/validado pelo pipeline"]
    end

    users["Usuários internos e cliente"] --> browser["Navegador"]
    browser --> frontendService
    frontendService --> frontendDeployment
    frontendConfig -.-> frontendDeployment
    frontendDeployment --> backendService
    backendService --> backendDeployment
    backendConfig -.-> backendDeployment
    backendSecret -.-> backendDeployment
    backendDeployment --> rds
    backendDeployment --> smtp["Servidor SMTP"]
    metrics["Metrics Server<br/>pré-requisito externo do HPA"] -.-> hpa
    hpa -.-> backendDeployment

        terraform --> eks
    deploy -. "cria/valida" .-> stateBucket

    classDef pipelineNode fill:#ecfdf5,stroke:#059669,color:#064e3b;
    classDef awsNode fill:#fff7ed,stroke:#ea580c,color:#7c2d12;
    classDef k8sNode fill:#eff6ff,stroke:#2563eb,color:#1e3a8a;
    classDef externalNode fill:#eef2ff,stroke:#4f46e5,color:#1e1b4b;
    classDef noteNode fill:#fefce8,stroke:#ca8a04,color:#713f12;
    classDef storageNode fill:#f3e8ff,stroke:#9333ea,color:#581c87;
    class repository,triggers,backendTests,frontendTests,backendBuild,frontendBuild,publish,deploy,terraform pipelineNode;
    class vpc,eks awsNode;
    class k8s,frontendService,frontendDeployment,frontendConfig,backendService,backendDeployment,backendConfig,backendSecret,hpa k8sNode;
    class users,browser,smtp externalNode;
    class metrics,snyk noteNode;
    class rds awsNode;
    class stateBucket storageNode;
