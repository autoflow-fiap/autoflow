%% Fotografia histórica anterior à topologia vigente API Gateway HTTP API + VPC Link/ALB; não representa configuração atual.
flowchart LR
    user["Usuário / navegador"]

    subgraph aws["AWS - us-east-1"]
        gateway["API Gateway HTTP v2<br/>stage homolog ou production<br/>POST /auth/login"]

        subgraph vpc["VPC 10.0.0.0/16"]
            subgraph eks["EKS eks-autoflow<br/>node group em subnets públicas"]
                frontendLb["Service frontend<br/>LoadBalancer :80"]
                frontend["Frontend Angular + Nginx<br/>container :8080"]
                backendLb["Service backend<br/>LoadBalancer :80 -> :8081"]
                backend["Backend Spring Boot<br/>container :8081"]
            end

            lambda["Lambda de autenticação<br/>Python 3.12<br/>subnets privadas"]
            rds["RDS PostgreSQL 17<br/>autoflow_db<br/>subnets privadas"]
            nat["NAT Gateway<br/>saída das subnets privadas"]
        end

        smtp["SMTP Gmail<br/>notificações por e-mail"]
    end

    user -->|"Acessa a aplicação"| frontendLb
    frontendLb --> frontend

    user -->|"Login: POST /stage/auth/login<br/>quando serverlessAuthUrl era configurada"| gateway
    gateway -->|"AWS_PROXY / payload 2.0"| lambda
    lambda -->|"SELECT em usuarios + clientes"| rds

    user -->|"APIs: /api/..."| frontendLb
    frontend -->|"Nginx remove /api e faz proxy"| backendLb
    backendLb --> backend
    backend -->|"JPA/Flyway/runtime"| rds
    backend -->|"SMTP"| smtp

    lambda -.->|"Saída de rede pela VPC"| nat
    lambda -.->|"SG efetivo exportado pelo state do banco"| rds
    backend -.->|"SG do EKS / porta 5432"| rds

    classDef public fill:#fff7ed,stroke:#ea580c,color:#7c2d12;
    classDef app fill:#eff6ff,stroke:#2563eb,color:#1e3a8a;
    classDef data fill:#f3e8ff,stroke:#9333ea,color:#581c87;
    classDef external fill:#eef2ff,stroke:#4f46e5,color:#1e1b4b;
    class gateway,frontendLb,backendLb public;
    class frontend,backend,lambda app;
    class rds data;
    class user,smtp external;
