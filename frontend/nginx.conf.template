server {
    listen 8080;
    server_name localhost;

    # Default combined logs include the request line (including query tokens).
    # Disable access logs until a query-redacting format is configured.
    access_log off;

    root /usr/share/nginx/html;
    index index.html;

    # Nunca permitir que APIs sem rota no Kong sejam servidas pela SPA.
    location = /api {
        return 404;
    }

    location ^~ /api/ {
        return 404;
    }

    location / {

        try_files $uri $uri/ /index.html;

    }


    location ~* \.(?:ico|css|js|gif|jpe?g|png|woff2?|eot|ttf|svg|map)$ {

        expires 1y;

        add_header Cache-Control "public, immutable";

    }


    gzip on;

    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
}
